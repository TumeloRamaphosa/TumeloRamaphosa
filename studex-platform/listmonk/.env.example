# Copy to .env and fill in. Do NOT commit the real .env.
# ---- Database (used by docker-compose) ----
LISTMONK_DB_USER=listmonk
LISTMONK_DB_PASSWORD=use-a-long-random-string
LISTMONK_DB_NAME=listmonk

# ---- Admin login for first boot (http://localhost:9000) ----
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=use-a-long-random-string

# ---- Host port + timezone ----
LISTMONK_PORT=9000
TZ=Africa/Johannesburg

# NOTE: SMTP is NOT set here. Configure your "agent mail" sending account inside
# Listmonk admin UI -> Settings -> SMTP (host, port 587, username, password).
# This keeps the whole stack open-source and provider-agnostic. See DELIVERABILITY.md.
