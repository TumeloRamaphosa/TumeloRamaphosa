# ===========================================
# StudEx Cognitive Brain + Claw Platform
# ===========================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
VERTEX_AI_ENDPOINT=https://us-central1-aiplatform.googleapis.com

# GitHub Integration
GITHUB_TOKEN=ghp_your_github_token
GITHUB_ORG=StudEx

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Daily AI-Tools Digest (Phase 4 add-on) ─────────────────────────
# Shared secret for the /api/digest/refresh cron endpoint. Generate one:
#   openssl rand -hex 32
# Vercel Cron will pass this automatically when set in the project's env.
# Callers from cron/curl/GH Actions send:
#   Authorization: Bearer $CRON_SECRET
CRON_SECRET=
