# ===========================================
# StudEx Cognitive Brain + Claw Platform
# ===========================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
VERTEX_AI_ENDPOINT=https://us-central1-aiplatform.googleapis.com

# GitHub Integration
GITHUB_TOKEN=ghp_your_github_token
GITHUB_ORG=StudEx

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Listmonk (open-source email marketing) — see listmonk/ for the self-host stack.
# LISTMONK_API_URL is where Listmonk runs (e.g. https://mail.studex.dev or http://localhost:9000).
# Create an API user in Listmonk: Settings -> Users -> add a user of type "API", copy its token.
LISTMONK_API_URL=http://localhost:9000
LISTMONK_API_USER=studex-site
LISTMONK_API_TOKEN=your-listmonk-api-token
# Numeric list IDs from Listmonk (Lists page). Comma-separate if a key maps to several.
LISTMONK_LIST_MEAT=1
LISTMONK_LIST_AGENT=2
# Segmented B2B lists (used by /api/contacts/sync-listmonk). Create matching lists in Listmonk.
LISTMONK_LIST_TIER_A=3
LISTMONK_LIST_TIER_B=4
LISTMONK_LIST_SA=5
LISTMONK_LIST_AFRICA=6

# Resend (transactional sending + Listmonk SMTP relay).
# Get a key at https://resend.com/api-keys. NEVER paste it in chat — put it in .env.local only.
RESEND_API_KEY=
RESEND_FROM_EMAIL="StudEx Meat <hello@studexmeat.com>"

# Admin CRM gate. Generate a long random string and share via secret manager.
ADMIN_TOKEN=replace-with-long-random-string
