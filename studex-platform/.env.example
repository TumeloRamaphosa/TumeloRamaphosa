# ─── META (Facebook + Instagram) ───────────────────────────────────────────
# Graph API version in use
GRAPH_API_VERSION=v20.0

# Page-level token — use for: posting to FB page, posting to IG, reading insights
# Expires: ~2026-08-04 (60 days from issue). Refresh via fb.me/token-debugger
META_PAGE_TOKEN=your-page-level-token

# User-level token — use for: Ads API (campaigns, adsets, creatives, adimages)
# NOTE: This expires daily as a short-lived token. Use System User token for production.
META_USER_TOKEN=your-user-level-token

# IDs
FACEBOOK_PAGE_ID=108934711902801
INSTAGRAM_ACCOUNT_ID=17841403538967823
META_AD_ACCOUNT_ID=act_560666565541381
FACEBOOK_APP_ID=1649681979685968

# Posting flows (see comments for Claude):
# FB IMAGE POST:  POST /v20.0/{PAGE_ID}/photos (source=file, published=false) → get photo_id
#                 POST /v20.0/{PAGE_ID}/feed (message + attached_media=[{media_fbid}])
# IG IMAGE POST:  POST /v20.0/{IG_ID}/media (image_url + caption) → poll status_code=FINISHED
#                 POST /v20.0/{IG_ID}/media_publish (creation_id)
# IG REEL:        Same as above but add media_type=REELS + video_url instead of image_url
# FB VIDEO:       POST /v20.0/{PAGE_ID}/videos (video_url + description)
# FB AD CREATIVE: Requires image uploaded via /{AD_ACCOUNT}/adimages first → use image_hash
#                 Then POST /{AD_ACCOUNT}/adcreatives with object_story_spec + instagram_actor_id

# ─── SHOPIFY ───────────────────────────────────────────────────────────────
SHOPIFY_STORE=studexmeat.myshopify.com
SHOPIFY_API_VERSION=2024-01
# Admin API key — get from Partners > Apps > studexmeat > API credentials
SHOPIFY_ADMIN_API_TOKEN=your-shopify-admin-token

# Useful endpoints:
# Orders today:  GET /admin/api/2024-01/orders.json?status=any&created_at_min={midnight_SAST}
# Inventory:     GET /admin/api/2024-01/inventory_levels.json?inventory_item_ids={ids}
# Revenue:       Sum total_price from orders

