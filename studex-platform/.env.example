# ===========================================
# StudEx Cognitive Brain + Claw Platform
# ===========================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
VERTEX_AI_ENDPOINT=https://us-central1-aiplatform.googleapis.com

# GitHub Integration
GITHUB_TOKEN=ghp_your_github_token
GITHUB_ORG=StudEx

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Listmonk (open-source email marketing) — see listmonk/ for the self-host stack.
# LISTMONK_API_URL is where Listmonk runs (e.g. https://mail.studex.dev or http://localhost:9000).
# Create an API user in Listmonk: Settings -> Users -> add a user of type "API", copy its token.
LISTMONK_API_URL=http://localhost:9000
LISTMONK_API_USER=studex-site
LISTMONK_API_TOKEN=your-listmonk-api-token
# Numeric list IDs from Listmonk (Lists page). Comma-separate if a key maps to several.
LISTMONK_LIST_MEAT=1
LISTMONK_LIST_AGENT=2
