# Hub Connector configuration (copy to .env on the Mac mini)

# Supabase project — use the SERVICE ROLE key (server-side only, never in a browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# A stable UUID identifying this hub. Generate once:
#   python -c "import uuid; print(uuid.uuid4())"
HUB_ID=

# Human-friendly name shown in the dashboard
HUB_NAME=Mac mini Home Hub

# Optional: owner user id (Supabase auth.users.id) for when Auth is wired up
HUB_OWNER_ID=

# Seconds between discovery scans
SCAN_INTERVAL=30

# ── Home Assistant (Phase 3a) ─────────────────────────────────────────
# Both must be set to enable real device dispatch via HA's WebSocket API.
# Without them the executor falls back to the stub (safe for Manus/demo).
# The URL is the WebSocket endpoint on your HA instance (usually port 8123).
# HA_TOKEN is a long-lived access token from HA → Profile → Security.
HA_URL=ws://homeassistant.local:8123/api/websocket
HA_TOKEN=
