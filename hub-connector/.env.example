# Hub Connector configuration (copy to .env on the Mac mini)

# Supabase project — use the SERVICE ROLE key (server-side only, never in a browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# A stable UUID identifying this hub. Generate once:
#   python -c "import uuid; print(uuid.uuid4())"
HUB_ID=

# Human-friendly name shown in the dashboard
HUB_NAME=Mac mini Home Hub

# Optional: owner user id (Supabase auth.users.id) for when Auth is wired up
HUB_OWNER_ID=

# Seconds between discovery scans
SCAN_INTERVAL=30
