# Mac mini Hub config — copy to .env and fill in. NEVER commit .env.

# Where the synced Obsidian vault lives on the Mac mini
VAULT_DIR=../../vault

# Perplexity (research engine)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Poll interval (seconds) when running in forever mode
POLL_INTERVAL=60

# --- Storefront data sources (for data_pull). Leave blank until ready. ---
SHOPIFY_STORE=studexmeat.myshopify.com
SHOPIFY_ADMIN_TOKEN=
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_ADS_DEVELOPER_TOKEN=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
