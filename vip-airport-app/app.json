{
  "expo": {
    "name": "Aviar VIP",
    "slug": "aviar-vip",
    "scheme": "aviar",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B0E1A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "money.aviar.vip",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Aviar uses your location to set your pickup point and match you with a nearby VIP chauffeur.",
        "UIBackgroundModes": ["location"]
      },
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_API_KEY"
      }
    },
    "android": {
      "package": "money.aviar.vip",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aviar uses your location to set your pickup point and match you with a nearby VIP chauffeur."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
