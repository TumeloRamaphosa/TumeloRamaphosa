# ============================================================
# Aviar VIP — Environment configuration
# Copy to ".env" and fill in. Anything exposed to the client
# MUST be prefixed with EXPO_PUBLIC_.
# ============================================================

# --- Supabase (client) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Google Maps / Street View (client) ---
# Used by the OR Tambo VIP walking-track Street View embed.
# Restrict this key to the Maps Embed API + your bundle ids.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-embed-key

# ============================================================
# SERVER-SIDE ONLY — never ship these in the app bundle.
# Used by the Supabase Edge Function `stitch-create-payment`.
# Set with: supabase secrets set KEY=value
# ============================================================

# --- Stitch (stitch.money) payment gateway ---
STITCH_CLIENT_ID=your-stitch-client-id
STITCH_CLIENT_SECRET=your-stitch-client-secret
STITCH_ENV=sandbox            # sandbox | live
# Deep link the hosted checkout returns to (matches app scheme):
STITCH_REDIRECT_URI=aviar://payment/return

# Supabase service role (Edge Function writes payment status):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
